FROM ghcr.io/cross-rs/riscv64gc-unknown-linux-gnu:0.2.5

# Install a modern cmake from Kitware's official APT repository.
# The Ubuntu 18.04 (bionic) base only ships cmake 3.10.2, but libz-ng-sys
# (transitive dep of async-compression) requires cmake >= 3.14.
RUN apt-get update -q && \
    apt-get install -y --no-install-recommends ca-certificates gpg wget && \
    wget -qO - https://apt.kitware.com/keys/kitware-archive-latest.asc \
        | gpg --dearmor -o /etc/apt/trusted.gpg.d/kitware.gpg && \
    echo "deb https://apt.kitware.com/ubuntu/ bionic main" \
        > /etc/apt/sources.list.d/kitware.list && \
    apt-get update -q && \
    apt-get install -y --no-install-recommends cmake && \
    rm -rf /var/lib/apt/lists/*

# Write a cmake toolchain file that tells cmake how to cross-compile for riscv64.
# The cross container has riscv64-linux-gnu-gcc installed at this path.
RUN printf '%s\n' \
    'set(CMAKE_SYSTEM_NAME Linux)' \
    'set(CMAKE_SYSTEM_PROCESSOR riscv64)' \
    'set(CMAKE_C_COMPILER riscv64-linux-gnu-gcc)' \
    'set(CMAKE_CXX_COMPILER riscv64-linux-gnu-g++)' \
    'set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)' \
    'set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)' \
    'set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)' \
    > /riscv64-toolchain.cmake

# Set CMAKE_TOOLCHAIN_FILE so the Rust cmake crate picks it up automatically.
# (Used by libz-ng-sys when cross-compiling.)
ENV CMAKE_TOOLCHAIN_FILE=/riscv64-toolchain.cmake
