# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# npm — downloaded native binaries (vendored by CI, not committed)
/npm/bin/native/

# Demo — Playwright and Node dependencies
/demo/node_modules/
/demo/package-lock.json
/demo/playwright-report/
/demo/test-results/

/coverage

# Local runtime artefacts
/*.log
/.mcp.json
/.env

# Reference clones of third-party projects (pingora, etc.) for source-reading
# during research/design work. Cloned on demand, never committed.
/.reference/

# Isolated git worktrees created by the harness for background subagents
# (Agent tool, isolation: "worktree") — transient working copies, never committed.
/.claude/worktrees/