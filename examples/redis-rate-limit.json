{
  "global": { "redis": { "url": "redis://127.0.0.1:6379" } },
  "sites": [
    {
      "port": 8080,
      "proxy": "http://localhost:4000",
      "rateLimit": {
        "windowSecs": 60,
        "limit": 100,
        "keyBy": "ip",
        "store": "redis",
        "skipPaths": ["/__health__", "/__metrics__"]
      }
    }
  ]
}
