{
  "port": 8080,
  "proxy": "http://localhost:4000",
  "middleware": [
    {
      "type": "ext_proc",
      "config": {
        "grpc": "grpc://127.0.0.1:50051",
        "timeoutMs": 200,
        "failOpen": false,
        "statusOnError": 503,
        "maxHeaderMutations": 64,
        "maxHeaderValueBytes": 8192
      }
    }
  ]
}
